{
  "name": "agor-aps-site",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "main": "src/worker.js",
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "agora.scuoladidialogosocratico@gmail.com"
    }
  ],
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  }
}
